{
  "name": "food-ai-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "dev:demo": "tsx scripts/dev-demo.ts",
    "poc:llm": "tsx scripts/poc-llm.ts",
    "live:check": "tsx scripts/live-check.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "record:artifact": "tsx scripts/record-artifact.ts",
    "build:artifact": "tsx scripts/build-artifact.ts",
    "preview:artifact": "vite preview --config vite.artifact.config.ts --outDir dist-artifact"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@hono/node-server": "^2.1.4",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
